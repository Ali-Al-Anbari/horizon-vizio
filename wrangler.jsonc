{
  // Local prototype only. The existing production Worker has no checked-in config.
  "name": "horizon-cloud-bridge-preview",
  "main": "./cloud/bridge-worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LAUNCH_QUEUE", "class_name": "LaunchQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LaunchQueue"] }]
}

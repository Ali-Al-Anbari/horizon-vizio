+#include "mbedtls/sha256.h"
 #if MBEDTLS_VERSION_NUMBER >= 0x03000000
 #include "mbedtls/build_info.h"
 #else
@@ -71,6 +72,10 @@
 #define MICROPY_MBEDTLS_CONFIG_BARE_METAL (0)
 #endif
 
+#ifndef MICROPY_PY_SSL_CERT_PIN_SHA256
+#define MICROPY_PY_SSL_CERT_PIN_SHA256 (0)
+#endif
+
 #define MP_STREAM_POLL_RDWR (MP_STREAM_POLL_RD | MP_STREAM_POLL_WR)
 
 #define MP_ENDPOINT_IS_SERVER (1 << 0)
@@ -93,6 +98,10 @@ typedef struct _mp_obj_ssl_context_t {
     int authmode;
     int *ciphersuites;
     mp_obj_t handler;
+    #if MICROPY_PY_SSL_CERT_PIN_SHA256
+    bool pin_enabled;
+    unsigned char pin_sha256[32];
+    #endif
     #if MICROPY_PY_SSL_ECDSA_SIGN_ALT
     mp_obj_t ecdsa_sign_callback;
     #endif
@@ -116,6 +125,9 @@ typedef struct _mp_obj_ssl_socket_t {
 
     uintptr_t poll_mask; // Indicates which read or write operations the protocol needs next
     int last_error; // The last error code, if any
+    #if MICROPY_PY_SSL_CERT_PIN_SHA256
+    bool pin_seen;
+    #endif
 
     #ifdef MBEDTLS_SSL_PROTO_DTLS
     mp_uint_t timer_start_ms;
@@ -267,6 +279,33 @@ static int ssl_sock_cert_verify(void *ptr, mbedtls_x509_crt *crt, int depth, uin
     return mp_obj_get_int(mp_call_function_2(o->handler, MP_OBJ_FROM_PTR(&cert), MP_OBJ_NEW_SMALL_INT(depth)));
 }
 
+#if MICROPY_PY_SSL_CERT_PIN_SHA256
+// This callback is bound to the TLS connection that receives the certificate.
+static int ssl_sock_cert_pin_verify(void *ptr, mbedtls_x509_crt *crt, int depth, uint32_t *flags) {
+    mp_obj_ssl_socket_t *sock = ptr;
+    if (depth == 0) {
+        unsigned char actual[32];
+        if (crt == NULL || crt->raw.p == NULL || crt->raw.len == 0 ||
+            mbedtls_sha256(crt->raw.p, crt->raw.len, actual, 0) != 0) {
+            return MBEDTLS_ERR_X509_FATAL_ERROR;
+        }
+        // Constant work for all 32 digest bytes, independent of the mismatch position.
+        volatile unsigned char difference = 0;
+        for (size_t i = 0; i < sizeof(actual); ++i) {
+            difference |= actual[i] ^ sock->ssl_context->pin_sha256[i];
+        }
+        if (difference != 0) {
+            return MBEDTLS_ERR_X509_FATAL_ERROR;
+        }
+        sock->pin_seen = true;
+    }
+    // The exact pinned leaf is this context's trust anchor. The TV's issuer
+    // is unavailable, so ordinary CA-chain flags must be overridden here.
+    *flags = 0;
+    return 0;
+}
+#endif
+
 /******************************************************************************/
 // SSLContext type.
 
@@ -295,6 +334,9 @@ static mp_obj_t ssl_context_make_new(const mp_obj_type_t *type_in, size_t n_args
     mbedtls_pk_init(&self->pkey);
     self->ciphersuites = NULL;
     self->handler = mp_const_none;
+    #if MICROPY_PY_SSL_CERT_PIN_SHA256
+    self->pin_enabled = false;
+    #endif
     #if MICROPY_PY_SSL_ECDSA_SIGN_ALT
     self->ecdsa_sign_callback = mp_const_none;
     #endif
@@ -534,6 +576,23 @@ static mp_obj_t ssl_context_load_verify_locations(mp_obj_t self_in, mp_obj_t cad
 }
 static MP_DEFINE_CONST_FUN_OBJ_2(ssl_context_load_verify_locations_obj, ssl_context_load_verify_locations);
 
+#if MICROPY_PY_SSL_CERT_PIN_SHA256
+// Runtime pin configuration: 32 raw SHA-256 bytes, never compiled into firmware.
+static mp_obj_t ssl_context_set_pin_sha256(mp_obj_t self_in, mp_obj_t pin_in) {
+    mp_obj_ssl_context_t *self = MP_OBJ_TO_PTR(self_in);
+    mp_buffer_info_t pin;
+    mp_get_buffer_raise(pin_in, &pin, MP_BUFFER_READ);
+    if (pin.len != sizeof(self->pin_sha256) ||
+        self->authmode != MBEDTLS_SSL_VERIFY_REQUIRED) {
+        mp_raise_ValueError(MP_ERROR_TEXT("pin requires 32 bytes and CERT_REQUIRED"));
+    }
+    memcpy(self->pin_sha256, pin.buf, sizeof(self->pin_sha256));
+    self->pin_enabled = true;
+    return mp_const_none;
+}
+static MP_DEFINE_CONST_FUN_OBJ_2(ssl_context_set_pin_sha256_obj, ssl_context_set_pin_sha256);
+#endif
+
 #if defined(MBEDTLS_SSL_HANDSHAKE_WITH_PSK_ENABLED)
 // mbedtls_ssl_ciphersuite_uses_psk() is declared only in mbedTLS's private
 // library/ssl_ciphersuites_internal.h, but it is a regular (linkable) symbol.
@@ -659,6 +718,9 @@ static const mp_rom_map_elem_t ssl_context_locals_dict_table[] = {
     { MP_ROM_QSTR(MP_QSTR_set_ciphers), MP_ROM_PTR(&ssl_context_set_ciphers_obj)},
     { MP_ROM_QSTR(MP_QSTR_load_cert_chain), MP_ROM_PTR(&ssl_context_load_cert_chain_obj)},
     { MP_ROM_QSTR(MP_QSTR_load_verify_locations), MP_ROM_PTR(&ssl_context_load_verify_locations_obj)},
+    #if MICROPY_PY_SSL_CERT_PIN_SHA256
+    { MP_ROM_QSTR(MP_QSTR_set_pin_sha256), MP_ROM_PTR(&ssl_context_set_pin_sha256_obj)},
+    #endif
     { MP_ROM_QSTR(MP_QSTR_wrap_socket), MP_ROM_PTR(&ssl_context_wrap_socket_obj) },
 };
 static MP_DEFINE_CONST_DICT(ssl_context_locals_dict, ssl_context_locals_dict_table);
@@ -761,6 +823,14 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
     o->sock = sock;
     o->poll_mask = 0;
     o->last_error = 0;
+    #if MICROPY_PY_SSL_CERT_PIN_SHA256
+    o->pin_seen = false;
+    if (ssl_context->pin_enabled && (server_side ||
+        ssl_context->authmode != MBEDTLS_SSL_VERIFY_REQUIRED ||
+        !do_handshake_on_connect)) {
+        mp_raise_ValueError(MP_ERROR_TEXT("pin requires blocking client handshake and CERT_REQUIRED"));
+    }
+    #endif
 
     int ret;
     uint32_t flags = 0;
@@ -783,6 +853,11 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
     }
 
     if (server_hostname != mp_const_none) {
+        #if MICROPY_PY_SSL_CERT_PIN_SHA256
+        if (ssl_context->pin_enabled) {
+            mbedtls_ssl_set_verify(&o->ssl, ssl_sock_cert_pin_verify, o);
+        }
+        #endif
         const char *sni = mp_obj_str_get_str(server_hostname);
         ret = mbedtls_ssl_set_hostname(&o->ssl, sni);
         if (ret != 0) {
@@ -824,6 +899,13 @@ static mp_obj_t ssl_socket_make_new(mp_obj_ssl_context_t *ssl_context, mp_obj_t
         }
     }
 
+    #if MICROPY_PY_SSL_CERT_PIN_SHA256
+    if (ssl_context->pin_enabled && !o->pin_seen) {
+        ret = MBEDTLS_ERR_X509_FATAL_ERROR;
+        goto cleanup;
+    }
+    #endif
+
     return MP_OBJ_FROM_PTR(o);
 
 cleanup:
